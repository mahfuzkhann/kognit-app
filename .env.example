# Copy this file to `.env` and fill in real values. `.env` is git-ignored -
# NEVER commit real keys, and never paste them into chat, tickets or project files.

# --- Required -----------------------------------------------------------
# Gemini API key (server-side only; never exposed to the browser).
GEMINI_API_KEY=

# Supabase project URL and the public anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------
# Gemini model used for chat, quizzes and titles.
# Leave unset (or empty) to use the built-in default: gemini-3.6-flash
# A value that is not a plausible model id is ignored with a warning.
# Example: GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=


# --- Plans and quotas (Pre-Phase 10) ------------------------------------
# enforce (default): free/pro limits are checked in the database for every chat and
#   quiz request. Apply supabase/migrations/0008-0011 BEFORE deploying code that
#   runs in this mode.
# off: skip every quota call (rollback switch / local development). Requests are
#   then unmetered.
# QUOTA_MODE=enforce

# --- Usage telemetry writer (migration 0011) ---------------------------
# Server-side secret that authorises the backend to write usage rows via
# public.record_ai_usage_events(). Store only its SHA-256 in public.usage_write_keys
# (see docs/DEPLOYMENT.md section 2a). Unset = usage rows are not recorded; chat,
# quizzes and quotas still work. It is NOT a service-role key.
# USAGE_WRITE_KEY=

# --- In-memory limits (Pre-Phase 10) -------------------------------------
# Defaults are assumptions documented in docs/DEPLOYMENT.md. Unset = default.
# PDF_CONTEXT_TTL_SECONDS=7200
# PDF_CONTEXT_MAX_PER_USER=5
# PDF_CONTEXT_MAX_CHARS_PER_USER=1500000
# PDF_CONTEXT_MAX_CHARS_GLOBAL=40000000
# QUIZ_DEFINITION_TTL_SECONDS=7200
# QUIZ_DEFINITION_MAX_PER_USER=10
# QUIZ_DEFINITION_MAX_GLOBAL=5000

# --- Concurrency (Pre-Phase 10) ------------------------------------------
# Ceiling on simultaneous streamed answers per server process. Unset/0 keeps the
# framework default (40). Size it from staging measurements; see docs/DEPLOYMENT.md.
# THREADPOOL_MAX_THREADS=0

# =========================================================================
# AI ENGINE 2.0 (docs/AI_ENGINE_2_0.md). EVERY setting below is optional and
# defaults to the pre-2.0 behaviour; deploying the code changes nothing until
# a flag is switched on. Apply supabase/migrations/0014 BEFORE deploying.
# =========================================================================
# --- Models (the two approved Gemini models; ids verified 2026-11-03) ----
# Override only to move to a new id. An overridden id gets NO verified price or
# thinking-level metadata (cost stays NULL) until the registry is updated.
# AI_MODEL_GENERAL=gemini-3.1-flash-lite
# AI_MODEL_ADVANCED=gemini-3.5-flash-lite

# --- Routing -------------------------------------------------------------
# static (default) = every request uses GEMINI_MODEL, exactly as before.
# shadow = the router decides and LOGS (route_reason=...), the legacy model is still used.
# policy = the routed model is used (3.1 for general text, 3.5 for images/PDFs/demanding subjects).
# AI_ROUTER_MODE=static
# Share of Pro requests, among those where both models are suitable, sent to the advanced model.
# AI_PRO_ADVANCED_SHARE_PERCENT=70
# Allow ONE pre-token switch to the other approved Gemini model (open breaker / 429). Same provider only.
# AI_MODEL_FALLBACK=off

# --- Context builder -----------------------------------------------------
# legacy (default) | v2 = layered prompt, curriculum from the verified profile,
# uploaded documents passed as delimited UNTRUSTED USER content (never in the system instruction).
# AI_CONTEXT_BUILDER=legacy
# AI_CONTEXT_DOC_MAX_CHARS=120000

# --- Verification (SHADOW ONLY - there is no student-facing mode) ---------
# off (default) | shadow. Costs extra model calls for eligible subjects; sample it.
# AI_VERIFY_MODE=off
# AI_VERIFY_SAMPLE_PERCENT=100

# --- Reliability ---------------------------------------------------------
# legacy = turn OFF the 2.0 deadlines / retry budget / breaker influence (rollback switch).
# AI_GATEWAY=v2
# AI_FIRST_TOKEN_DEADLINE_SECONDS=75
# AI_STREAM_DEADLINE_SECONDS=240
# AI_RETRY_BUDGET_BURST=30
# AI_RETRY_BUDGET_REFILL_PER_SECOND=3
# AI_BREAKER_FAILURES=5
# AI_BREAKER_COOLDOWN_SECONDS=30

# --- Concurrency (keep MAX_INFLIGHT below THREADPOOL_MAX_THREADS / the default 40) ---
# AI_MAX_INFLIGHT_GENERATIONS=32
# AI_MAX_QUEUED_GENERATIONS=64
# AI_QUEUE_WAIT_SECONDS=8

# --- Plan gating ---------------------------------------------------------
# enforce (default) | off. 'off' is the rollback for server-side Free/Pro feature gating.
# PLAN_GATING=enforce
