# Copy this file to `.env` and fill in real values. `.env` is git-ignored -
# NEVER commit real keys, and never paste them into chat, tickets or project files.

# --- Required -----------------------------------------------------------
# Gemini API key (server-side only; never exposed to the browser).
GEMINI_API_KEY=

# Supabase project URL and the public anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------
# Gemini model used for chat, quizzes and titles.
# Leave unset (or empty) to use the built-in default: gemini-3.6-flash
# A value that is not a plausible model id is ignored with a warning.
# Example: GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=

