# Copy this file to `.env` and fill in real values. `.env` is git-ignored -
# NEVER commit real keys, and never paste them into chat, tickets or project files.

# --- Required -----------------------------------------------------------
# Gemini API key (server-side only; never exposed to the browser).
GEMINI_API_KEY=

# Supabase project URL and the public anon/publishable key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------
# Gemini model used for chat, quizzes and titles.
# Leave unset (or empty) to use the built-in default: gemini-3.6-flash
# A value that is not a plausible model id is ignored with a warning.
# Example: GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=


# --- Plans and quotas (Pre-Phase 10) ------------------------------------
# enforce (default): free/pro limits are checked in the database for every chat and
#   quiz request. Apply supabase/migrations/0008-0011 BEFORE deploying code that
#   runs in this mode.
# off: skip every quota call (rollback switch / local development). Requests are
#   then unmetered.
# QUOTA_MODE=enforce

# --- Usage telemetry writer (migration 0011) ---------------------------
# Server-side secret that authorises the backend to write usage rows via
# public.record_ai_usage_events(). Store only its SHA-256 in public.usage_write_keys
# (see docs/DEPLOYMENT.md section 2a). Unset = usage rows are not recorded; chat,
# quizzes and quotas still work. It is NOT a service-role key.
# USAGE_WRITE_KEY=

# --- In-memory limits (Pre-Phase 10) -------------------------------------
# Defaults are assumptions documented in docs/DEPLOYMENT.md. Unset = default.
# PDF_CONTEXT_TTL_SECONDS=7200
# PDF_CONTEXT_MAX_PER_USER=5
# PDF_CONTEXT_MAX_CHARS_PER_USER=1500000
# PDF_CONTEXT_MAX_CHARS_GLOBAL=40000000
# QUIZ_DEFINITION_TTL_SECONDS=7200
# QUIZ_DEFINITION_MAX_PER_USER=10
# QUIZ_DEFINITION_MAX_GLOBAL=5000

# --- Concurrency (Pre-Phase 10) ------------------------------------------
# Ceiling on simultaneous streamed answers per server process. Unset/0 keeps the
# framework default (40). Size it from staging measurements; see docs/DEPLOYMENT.md.
# THREADPOOL_MAX_THREADS=0
